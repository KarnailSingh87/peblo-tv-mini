# ==============================================================================
# Peblo TV Mini — Complete Environment Configuration Template
# Copy this file to .env and configure the variables for your environment.
# ==============================================================================

# --- Application Metadata ---
PROJECT_NAME="Peblo TV Mini API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# --- PostgreSQL Container Credentials (Used by docker-compose) ---
POSTGRES_USER="peblo_user"
POSTGRES_PASSWORD="peblo_password"
POSTGRES_DB="peblo_tv_db"

# --- Database Connection URL ---
# Local SQLite fallback: sqlite:///./peblo_tv.db
# Docker Compose network: postgresql://peblo_user:peblo_password@db:5432/peblo_tv_db
# Local PostgreSQL: postgresql://peblo_user:peblo_password@localhost:5432/peblo_tv_db
DATABASE_URL="postgresql://peblo_user:peblo_password@localhost:5432/peblo_tv_db"

# --- Authentication & JWT Security ---
# Secret key used to sign and verify HMAC-SHA256 JWT tokens. Must be minimum 32 characters in production.
SECRET_KEY="super-secret-peblo-tv-jwt-signing-key-32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Seed Development Credentials ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
EDITOR_USERNAME="editor"
EDITOR_PASSWORD="editor123"

# --- Storage Engine Configuration ---
# Options: "local" | "r2" | "s3"
STORAGE_TYPE="local"
LOCAL_STORAGE_DIR="./storage"

# --- Cloudflare R2 / AWS S3 Credentials (Required only when STORAGE_TYPE is "r2" or "s3") ---
S3_ENDPOINT_URL="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your-r2-or-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-r2-or-s3-secret-access-key"
S3_BUCKET_NAME="peblo-tv-catalogue"
S3_REGION_NAME="auto"
S3_PUBLIC_BASE_URL="https://cdn.peblo.tv"

# --- CORS Allowed Origins ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# --- Frontend API Base URLs (Used during Vite build/development) ---
VITE_API_BASE_URL="http://localhost:8000/api/v1"
